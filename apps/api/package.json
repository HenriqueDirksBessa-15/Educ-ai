{
  "name": "@educai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed-cli.ts",
    "db:import-bncc": "tsx src/db/import-bncc-cli.ts"
  },
  "dependencies": {
    "@educai/contracts": "0.1.0",
    "@fastify/cookie": "10.0.1",
    "@fastify/cors": "11.3.1",
    "ajv": "8.17.1",
    "dotenv": "17.2.3",
    "fastify": "5.12.5",
    "google-auth-library": "10.5.0",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "20.19.17",
    "@types/pg": "8.15.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
